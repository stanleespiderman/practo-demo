{
  "name": "practo-interface-demo",
  "version": "0.2.0",
  "private": true,
  "description": "Native Android source and separate browser review; fictional local demo only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preview": "node scripts/serve-preview.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "seed:sync": "node scripts/sync-seed.mjs",
    "seed:check": "node scripts/sync-seed.mjs --check",
    "check": "node scripts/check.mjs",
    "format": "prettier --write \"web/*.{js,css,html}\" \"scripts/*.mjs\" \"tests/*.mjs\" package.json",
    "format:check": "prettier --check \"web/*.{js,css,html}\" \"scripts/*.mjs\" \"tests/*.mjs\" package.json"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
